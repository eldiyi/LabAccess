<?xml version="1.0" encoding="utf-8"?>
<!--
   P3.1 · Almacenamiento local seguro (Ignacio Ferrer Téllez)

   Reglas para Android 11 y anteriores. LabAccess tiene minSdk 34, así que en
   la práctica manda data_extraction_rules.xml; se mantienen por coherencia y
   el manifiesto declara además android:allowBackup="false".
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
